{application, erwaf, [
    {description, "ErWAF is a naive implementation of Web Application Firewall written in Erlang for educational purposes.
        This project is created to study the basics of Erlang, WAF and demonstrate the results."
    },
    {vsn, "0.1.0"},
    {registered, []},
    {mod, {erwaf_app, []}},
    {applications, [
        kernel,
        stdlib,
        sasl                    %% sasl is an app to upgrade/downgrade releases on the fly
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, []}
 ]}.
