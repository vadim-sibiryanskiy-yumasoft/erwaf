{profiles, [
    {test, [
        {erl_opts, [debug_info, beam_debug_info, beam_debug_stack]}
    ]}
]}.

{erl_opts, [debug_info]}.
{deps, [
    % {cowboy, "2.18.0", {git, "https://github.com/ninenines/cowboy.git", {tag, "2.18.0"}}},
    {eqwalizer_support, {
        git_subdir,
        "https://github.com/whatsapp/eqwalizer.git",
        {branch, "main"},
        "eqwalizer_support"}
    }
]}.

{shell, [
    %% {config, "config/sys.config"},
    {apps, [erwaf]}
]}.

%% Release section
{relx, [{release, {erwaf, "0.1.0"}, [erwaf]}, 

        {dev_mode, true},
        {include_erts, false},

        {extended_start_script, true}]}.